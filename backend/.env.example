# Copia este archivo como .env y ajusta los valores según tu entorno.
# Uvicorn puede cargarlo con: uvicorn app.main:app --env-file .env --app-dir backend
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=SaberProDB
NEON_AUTH_BASE_URL=https://tu-proyecto.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://tu-proyecto.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173

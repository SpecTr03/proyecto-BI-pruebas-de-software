# ============================================================================
# Plantilla de variables de entorno del backend.
#
# Uso:
#   cp backend/.env.example backend/.env
#
# Nunca confirmes el archivo .env real en el repositorio.
# Los valores de Neon los comparte el líder del equipo por un canal privado.
# ============================================================================

# ----------------------------------------------------------------------------
# MongoDB
# ----------------------------------------------------------------------------
# URI y nombre de la base NoSQL. Ajusta el host si MongoDB no es local.
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=SaberProDB

# ----------------------------------------------------------------------------
# Neon Auth y Neon PostgreSQL
# ----------------------------------------------------------------------------
# Valores entregados por el líder del equipo desde el proyecto Neon.
# Reemplaza <tu-proyecto> y <region> por los datos reales.
NEON_AUTH_BASE_URL=https://<tu-proyecto>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<tu-proyecto>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# URL agrupada (pooled) de Neon PostgreSQL usada por la aplicación.
# Formato: postgresql://<usuario>:<password>@<host>/<base>?sslmode=require
DATABASE_URL=postgresql://<usuario>:<password>@<host>/<base>?sslmode=require

# ----------------------------------------------------------------------------
# JWT de la aplicación
# ----------------------------------------------------------------------------
# Secreto usado para firmar los JWT propios del backend.
# Debe tener al menos 32 caracteres.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
APP_JWT_SECRET=<secreto-aleatorio-de-al-menos-32-caracteres>

# ----------------------------------------------------------------------------
# CORS del frontend
# ----------------------------------------------------------------------------
# Orígenes permitidos por FastAPI. Incluye localhost y 127.0.0.1 si usas ambos.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
